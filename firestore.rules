rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid} ───────────────────────────────────────────────────────────
    // Lectura: cualquier usuario autenticado (necesario para búsqueda de amigos por email).
    // Escritura: el propio usuario o un admin.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // ── mathgo_progress/{uid} ─────────────────────────────────────────────────
    // Lectura: cualquier usuario autenticado (XP ya es público en el leaderboard).
    // Escritura: solo el propio usuario.
    match /mathgo_progress/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── subjects/ ─────────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer los ejercicios.
    // Nadie puede escribir desde el cliente (solo el backend con credenciales de servicio).
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /units/{unitId} {
        allow read: if request.auth != null;
        allow write: if false;

        match /levels/{levelId} {
          allow read: if request.auth != null;
          allow write: if false;

          match /exercises/{exerciseId} {
            allow read: if request.auth != null;
            allow write: if false;
          }
        }
      }
    }

    // ── missions/ ─────────────────────────────────────────────────────────────
    // Catálogo global: cualquier usuario autenticado puede leer.
    // Solo el backend escribe (credenciales de servicio).
    match /missions/{missionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── achievements/ ─────────────────────────────────────────────────────────
    // Catálogo global: cualquier usuario autenticado puede leer.
    // Solo el backend escribe (credenciales de servicio).
    match /achievements/{achievementId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── user_missions/{uid}/missions/{missionId} ───────────────────────────────
    // Solo el propio usuario puede leer su progreso en misiones.
    // El backend escribe via credenciales de servicio (bypassa estas reglas).
    match /user_missions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /missions/{missionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── user_achievements/{uid}/achievements/{achievementId} ───────────────────
    // Solo el propio usuario puede leer sus logros desbloqueados.
    match /user_achievements/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── mathgo_worlds/ ────────────────────────────────────────────────────────
    // Datos de mundos: cualquier usuario autenticado puede leer.
    // Solo el backend escribe via Admin SDK.
    match /mathgo_worlds/{worldId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── attempts/{attemptId} ──────────────────────────────────────────────────
    // El backend escribe via Admin SDK (bypasa estas reglas).
    // Lectura: el propio dueño del intento o un usuario con role == 'admin'.
    match /attempts/{attemptId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow write: if false;
    }

    // ── classrooms/{classroomId} ──────────────────────────────────────────────
    // Lectura:   el profesor dueño del salón o un admin.
    // Creación:  solo usuarios con role == 'teacher'; teacherId debe ser su propio uid.
    // Actualiz.: solo el profesor dueño (agregar/quitar alumnos de studentIds).
    // Borrado:   solo el profesor dueño.
    match /classrooms/{classroomId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.teacherId ||
        request.auth.uid in resource.data.studentIds ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if request.auth != null &&
        request.resource.data.teacherId == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.teacherId;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.teacherId;
    }

    // ── assignments/{assignmentId} ────────────────────────────────────────────
    // Lectura:   el teacher dueño del classroom, alumnos del classroom, o admin.
    // Creación:  solo el teacher dueño del classroom referenciado.
    // Actualiz./Borrado: solo el teacher dueño del classroom.
    match /assignments/{assignmentId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/classrooms/$(resource.data.classroomId)).data.teacherId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/classrooms/$(resource.data.classroomId)).data.studentIds ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' &&
        get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/classrooms/$(resource.data.classroomId)).data.teacherId == request.auth.uid;
    }

    // ── friendRequests/{requestId} ────────────────────────────────────────────
    // Solo los dos participantes (fromUid / toUid) o un admin ven el doc.
    // Crear: solo el remitente, status inicial 'pending', sin enviarse a sí mismo.
    // Aceptar: solo el receptor, transición exacta pending → accepted; campos inmutables.
    // Eliminar: cualquiera de los dos participantes, en cualquier estado.
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.fromUid != request.resource.data.toUid;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.toUid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    // ── Resto de colecciones ──────────────────────────────────────────────────
    // Denegar acceso a todo lo no definido explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
